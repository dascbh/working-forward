{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://working-forward.dev/schemas/experience.schema.json",
  "title": "Working Forward L4 — experience.yaml",
  "type": "object",
  "required": ["flows", "screens"],
  "properties": {
    "flows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "serves", "initial", "states"],
        "properties": {
          "id": { "type": "string", "pattern": "^FLW-[A-Z0-9-]+$" },
          "serves": { "type": "array", "items": { "type": "string", "pattern": "^MOM-" } },
          "initial": { "type": "string" },
          "states": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "screen": { "type": "string", "pattern": "^SCR-[A-Z0-9-]+$" },
                "invoke": { "type": "string", "description": "CMD-* de L3" },
                "covers": { "type": "array", "items": { "type": "string" }, "description": "EDG-* que este estado trata" },
                "must_render": { "type": "array", "items": { "type": "string" } },
                "on": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object", "required": ["target"],
                    "properties": {
                      "target": { "type": "string" },
                      "guard": { "type": "string", "pattern": "^VAL-" },
                      "covers": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "rule", "derived_from"],
        "properties": {
          "id": { "type": "string", "pattern": "^VAL-[A-Z0-9-]+$" },
          "field": { "type": "string" },
          "rule": { "type": "string" },
          "derived_from": { "type": "string", "pattern": "^(POL|EDG)-[A-Z0-9-]+$", "description": "POL-* ou EDG-* — validação sem pedigree é decisão clandestina" }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^SCR-[A-Z0-9-]+$" },
          "components": { "type": "array", "items": { "type": "string" } },
          "tokens_scope": { "type": "string" }
        }
      }
    }
  }
}
