{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://working-forward.dev/schemas/domain.schema.json",
  "title": "Working Forward L3 — domain.yaml",
  "type": "object",
  "required": ["events", "commands", "aggregates", "contexts"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "aggregate"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVT-[A-Za-z0-9]+$" },
          "aggregate": { "type": "string" },
          "emitted_by": { "type": "string", "description": "BCK-* ou CMD-*" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "produces"],
        "properties": {
          "id": { "type": "string", "pattern": "^CMD-[A-Za-z0-9]+$" },
          "actor": { "type": "string" },
          "produces": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^RCT-[A-Z0-9-]+$" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "implements": { "type": "string", "description": "POL-* de L2" }
        }
      }
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^AGG-[A-Za-z0-9]+$" },
          "invariants": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contexts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "aggregates"],
        "properties": {
          "id": { "type": "string", "pattern": "^CTX-[A-Za-z0-9]+$" },
          "aggregates": { "type": "array", "items": { "type": "string" } },
          "moments_served": { "type": "array", "items": { "type": "string" } },
          "relationship": {
            "type": "object",
            "properties": { "with": { "type": "string" }, "type": { "type": "string" } }
          }
        }
      }
    }
  }
}
