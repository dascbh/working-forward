{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#0A1F44", "$type": "color" },
                 "accent":  { "$value": "#00C2A8", "$type": "color" } },
    "semantic": {
      "approved": { "$value": "#0E7A4D", "$type": "color", "$description": "crédito aprovado" },
      "pending":  { "$value": "#B45309", "$type": "color", "$description": "decisão em análise além do tempo-alvo" },
      "denied":   { "$value": "#B91C1C", "$type": "color", "$description": "crédito negado" },
      "settled":  { "$value": "#5B6EF5", "$type": "color", "$description": "venda repassada à plataforma parceira" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Inter", "$type": "fontFamily" },
                "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
