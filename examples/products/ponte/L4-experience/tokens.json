{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#0F2A3D", "$type": "color" },
                 "accent":  { "$value": "#E8590C", "$type": "color" } },
    "semantic": {
      "critical":  { "$value": "#B91C1C", "$type": "color", "$description": "criticidade alta / necessidade não atendida" },
      "verified":  { "$value": "#0E7A4D", "$type": "color", "$description": "necessidade verificada / resolvida" },
      "offline":   { "$value": "#5B5F73", "$type": "color", "$description": "aguardando sincronização (EDG-06/EDG-07)" },
      "override":  { "$value": "#B45309", "$type": "color", "$description": "decisão com override — sempre com justificativa visível" }
    }
  },
  "font": {
    "family": { "base": { "$value": "IBM Plex Sans", "$type": "fontFamily" },
                "mono": { "$value": "IBM Plex Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
