{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#12172B", "$type": "color" },
                 "accent":  { "$value": "#4C5FF0", "$type": "color" } },
    "semantic": {
      "escrow":     { "$value": "#8A5A00", "$type": "color", "$description": "valor em custódia, ainda não liberado" },
      "verified":   { "$value": "#0E7A4D", "$type": "color", "$description": "resultado verificado / escrow liberado" },
      "paused":     { "$value": "#5B5F73", "$type": "color", "$description": "execução pausada aguardando mandante" },
      "dispute":    { "$value": "#B91C1C", "$type": "color", "$description": "mandato em disputa / arbitragem" },
      "emerging":   { "$value": "#0C6CF4", "$type": "color", "$description": "badge de operador emergente (EDG-02)" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Inter", "$type": "fontFamily" },
                "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
