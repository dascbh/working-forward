{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#14213D", "$type": "color" },
                 "accent":  { "$value": "#FCA311", "$type": "color" } },
    "semantic": {
      "available":  { "$value": "#0E7A4D", "$type": "color", "$description": "estoque disponível" },
      "reserved":   { "$value": "#8A5A00", "$type": "color", "$description": "estoque reservado / contagem regressiva" },
      "unavailable":{ "$value": "#B91C1C", "$type": "color", "$description": "item indisponível / reserva expirada" },
      "pending":    { "$value": "#5B6EF5", "$type": "color", "$description": "pagamento assíncrono aguardando confirmação" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Sora", "$type": "fontFamily" },
                "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
