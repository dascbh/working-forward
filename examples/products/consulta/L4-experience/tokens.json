{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#0B3D3A", "$type": "color" },
                 "accent":  { "$value": "#1AA37A", "$type": "color" } },
    "semantic": {
      "low_risk":    { "$value": "#0E7A4D", "$type": "color", "$description": "risco baixo na triagem" },
      "medium_risk": { "$value": "#B45309", "$type": "color", "$description": "risco médio / incerto" },
      "emergency":   { "$value": "#B91C1C", "$type": "color", "$description": "emergência detectada — sempre redireciona" },
      "connecting":  { "$value": "#5B6EF5", "$type": "color", "$description": "reconectando chamada de vídeo" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Source Sans 3", "$type": "fontFamily" },
                "mono": { "$value": "IBM Plex Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
