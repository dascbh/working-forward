{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#1B1F3B", "$type": "color" },
                 "accent":  { "$value": "#5B6EF5", "$type": "color" } },
    "semantic": {
      "bot":        { "$value": "#5B6EF5", "$type": "color", "$description": "mensagens e ações do bot" },
      "human":      { "$value": "#0E7A4D", "$type": "color", "$description": "atendente humano / escalação" },
      "blocked":    { "$value": "#8A5A00", "$type": "color", "$description": "resposta bloqueada por baixa confiança" },
      "frustrated": { "$value": "#B91C1C", "$type": "color", "$description": "sinal de frustração detectado" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Inter", "$type": "fontFamily" },
                "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
