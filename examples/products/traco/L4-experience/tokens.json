{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#1B1B1F", "$type": "color" },
                 "accent":  { "$value": "#E8543E", "$type": "color", "$description": "cor do traço/prompt do dia" } },
    "semantic": {
      "tecnico":    { "$value": "#2F6F4F", "$type": "color", "$description": "badge de feedback técnico (distinto de reação simples)" },
      "pausa":      { "$value": "#8A7A5C", "$type": "color", "$description": "sequência em pausa — nunca vermelho/erro, para não parecer punição" },
      "descoberta": { "$value": "#3557C6", "$type": "color", "$description": "contexto de busca de talento, visualmente separado do feed de prática" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Inter", "$type": "fontFamily" },
                "display": { "$value": "Fraunces", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
