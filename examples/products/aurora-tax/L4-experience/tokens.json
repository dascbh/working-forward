{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#07305D", "$type": "color" },
                 "accent":  { "$value": "#0C6CF4", "$type": "color" } },
    "semantic": {
      "verified":   { "$value": "#0E7A4D", "$type": "color", "$description": "citação verificada" },
      "caveat":     { "$value": "#B45309", "$type": "color", "$description": "ressalva de vigência (EDG-05)" },
      "danger":     { "$value": "#B91C1C", "$type": "color" }
    }
  },
  "font": {
    "family": { "base": { "$value": "IBM Plex Sans", "$type": "fontFamily" },
                "mono": { "$value": "IBM Plex Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
