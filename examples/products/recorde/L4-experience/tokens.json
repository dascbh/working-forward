{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "primary": { "$value": "#101828", "$type": "color" },
                 "accent":  { "$value": "#7C5CFC", "$type": "color" } },
    "semantic": {
      "active":    { "$value": "#0E7A4D", "$type": "color", "$description": "assinatura ativa / cobrança bem-sucedida" },
      "paused":    { "$value": "#5B5F73", "$type": "color", "$description": "assinatura pausada" },
      "retrying":  { "$value": "#B45309", "$type": "color", "$description": "em janela de retentativa" },
      "suspended": { "$value": "#B91C1C", "$type": "color", "$description": "acesso suspenso por falha de cobrança" }
    }
  },
  "font": {
    "family": { "base": { "$value": "Inter", "$type": "fontFamily" },
                "mono": { "$value": "IBM Plex Mono", "$type": "fontFamily" } }
  },
  "space": { "sm": { "$value": "8px", "$type": "dimension" },
             "md": { "$value": "16px", "$type": "dimension" },
             "lg": { "$value": "24px", "$type": "dimension" } }
}
